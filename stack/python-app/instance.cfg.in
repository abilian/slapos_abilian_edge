{#- Rendered at build time with the app's [python-app] (app) and
    [python-app-processes] (processes); what it gives the processes is in README.md. -#}
{%- set name = app['name'] %}
{%- set database = app['postgresql-bin'] %}
{%- set health = app['health'] %}
{%- set secrets = app['secrets'].split() %}
{#- buildout adds _profile_base_location_ and the like to a section. #}
{%- set ns = namespace(processes=[]) %}
{%- for process in processes if process[:1] != '_' %}
{%-   set ns.processes = ns.processes + [process] %}
{%- endfor %}
{%- set process_list = ns.processes %}
{%- set process_path = [path, app['path'], database] | select | join(':') %}
{#- The app writes next to its code: it runs from a copy, with its volumes. #}
{%- set copy = app['copy'] == 'true' %}
{%- set run_directory = '${workdir:location}' if copy else app_directory %}
{#- On one line: a buildout value's next lines would need indenting. #}
{%- set build_id = app['build-id'].split() | join(' ') %}
{#- The app listens on IPv4 (0.0.0.0, as behind Hop3's proxy): a haproxy
    brings the frontend's IPv6 to it. #}
{%- set ipv4 = app['bind'] == 'ipv4' %}
{%- set release = 'release' in process_list %}
[buildout]
parts =
{%- if database %}
  postgresql
{%- endif %}
{%- for process in process_list %}
  process-{{ process }}
{%- endfor %}
{%- if ipv4 %}
  haproxy
{%- endif %}
{%- if 'web' in process_list %}
  listen-promise
{%-   if health %}
  backend-health-promise
  frontend-health-promise
{%-   endif %}
{%- endif %}
  publish-connection-parameter

eggs-directory = {{ buildout['eggs-directory'] }}
develop-eggs-directory = {{ buildout['develop-eggs-directory'] }}
offline = true

extends = {{ template_monitor }}


[slap-configuration]
recipe = slapos.cookbook:slapconfiguration
computer = ${slap-connection:computer-id}
partition = ${slap-connection:partition-id}
url = ${slap-connection:server-url}
key = ${slap-connection:key-file}
cert = ${slap-connection:cert-file}


[directory]
recipe = slapos.cookbook:mkdirectory
home = ${buildout:directory}
etc = ${:home}/etc
var = ${:home}/var
srv = ${:home}/srv
script = ${:etc}/run
service = ${:etc}/service
process = ${:etc}/process
log = ${:var}/log
run = ${:var}/run
tmp = ${:srv}/tmp
fontconfig-cache = ${:home}/.fontconfig


{%- if ipv4 %}
# Every partition's app binds 0.0.0.0:PORT or :PORT, so the port is the
# partition's. haproxy has another one: :PORT also takes the IPv6 wildcard, and
# would collide with haproxy's bind on the same port number.
# haproxy reaches the app on 127.0.0.1, as Hop3's nginx does: gunicorn then
# trusts the frontend's X-Forwarded-Proto, and Django sees https.
# ponytail: assumes partitions named slappartN, as on every SlapOS node.
[app-parameters]
recipe = slapos.recipe.build
init =
  partition = int(self.buildout['slap-connection']['partition-id'][len('slappart'):])
  options['port'] = str(30000 + partition)
  options['backend-port'] = str(20000 + partition)
  # Here, not as a url option: buildout substitutes those before init runs.
  options['url'] = 'http://[%s]:%s' % (options['backend-host'], options['backend-port'])
host = 127.0.0.1
backend-host = ${slap-configuration:ipv6-random}
{%- else %}
[app-parameters]
host = ${slap-configuration:ipv6-random}
port = {{ app['port'] }}
url = http://[${:host}]:${:port}
{%- endif %}
{%- if copy %}


# A copy of the build, made again when the build changes; the volumes live
# outside it, linked at their targets: seeded once from what the build left
# there, then kept.
[workdir]
recipe = slapos.recipe.build
source = {{ app_directory }}
build = {{ build_id }}
location = ${directory:srv}/app
volumes = ${directory:srv}/volumes
targets =
{%-   for line in app['volumes'].splitlines() | select %}
  {{ line }}
{%-   endfor %}
install =
  import os, shutil
  shutil.copytree(options['source'], location, symlinks=True)
  for line in options['targets'].splitlines():
    if not line.strip():
      continue
    name, target = line.split()
    volume = os.path.join(options['volumes'], name)
    target = os.path.join(location, target)
    if not os.path.exists(volume):
      os.makedirs(options['volumes'], exist_ok=True)
      if os.path.isdir(target):
        shutil.move(target, volume)
      else:
        os.mkdir(volume)
    elif os.path.isdir(target):
      shutil.rmtree(target)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    os.symlink(volume, target)
{%- endif %}
{%- if release %}


# Services wait for the release to have run with what they run with: its
# marker is named after the parameters, the build and the frontend's URL, which
# comes after the first run and which release scripts write into configuration.
[release-key]
recipe = slapos.recipe.build
build = {{ build_id }}
frontend = ${request-frontend:connection-secure_access}
init =
  import hashlib
  parameters = self.buildout['slap-configuration']['configuration']
  key = repr(sorted(parameters.items())) + options['build'] + options['frontend']
  options['marker'] = '${directory:run}/release-' + hashlib.md5(key.encode()).hexdigest()
{%- endif %}

{%- if database %}


[postgresql-password]
recipe = slapos.cookbook:generate.password

[postgresql]
recipe = slapos.cookbook:postgres
bin = {{ database }}/
services = ${directory:service}
dbname = {{ name }}
superuser = {{ name }}
password = ${postgresql-password:passwd}
pgdata-directory = ${directory:srv}/postgresql
ipv4 = ${slap-configuration:ipv4-random}
ipv6 =
port = 5432
{%- endif %}
{%- for secret in secrets %}
{%-   set name, kind = (secret ~ ':').split(':')[:2] %}


# Must never change once the app has used it: generated once, kept in parts/.
[secret-{{ name }}]
recipe = slapos.cookbook:generate.password
bytes = 32
{%-   if kind %}

# 32 bytes from it, as NAME:kind in secrets asks: for the apps that decode theirs.
[secret-{{ name }}-encoded]
recipe = slapos.recipe.build
passwd = ${secret-{{ name }}:passwd}
kind = {{ kind }}
init =
  import base64, hashlib
  raw = hashlib.sha256(options['passwd'].encode()).digest()
  options['value'] = {
    'hex': raw.hex(),
    'base64': base64.b64encode(raw).decode(),
    'urlsafe': base64.urlsafe_b64encode(raw).rstrip(b'=').decode(),
  }[options['kind']]
{%-   endif %}
{%- endfor %}
{%- if app['fonts'] %}


[fontconfig-conf]
recipe = slapos.recipe.template:jinja2
url = {{ app['fonts-conf'] }}
output = ${directory:etc}/fonts.conf
context =
    key cachedir directory:fontconfig-cache
    key fonts :fonts
    key includes :includes
fonts =
{%-   for font in app['fonts'].split() %}
    {{ font }}
{%-   endfor %}
includes =
    {{ app['fontconfig-includes'] }}
{%- endif %}


# The app's own names for what the stack gives ([python-app] environment), as
# shell lines: FLASK_SERVER_NAME=$DOMAIN.
[app-environment]
recipe = slapos.recipe.template
output = ${directory:etc}/app.env
inline =
  :
{%- for line in app['environment'].splitlines() | select %}
  export {{ line }}
{%- endfor %}

# The instance's parameters, as environment variables under their own names
# (as `hop3 config set`). Read last, so a parameter overrides everything.
[parameters-environment]
recipe = slapos.recipe.template:jinja2
output = ${directory:etc}/parameters.env
context = key parameters slap-configuration:configuration
inline =
{%- raw %}
  {%- for name, value in parameters | dictsort %}
  {%-   if name.isidentifier() %}
  export {{ name }}='{{ value | string | replace("'", "'\\''") }}'
  {%-   else %}
  echo "parameters.env: an instance parameter is not a variable name" >&2; exit 1
  {%-   endif %}
  {%- endfor %}
{% endraw %}


# Services start with an empty environment: everything a process gets is here.
[process-base]
recipe = slapos.cookbook:wrapper
environment =
  PATH={{ process_path }}
  LD_LIBRARY_PATH={{ app['library-path'] }}
  HOME=${directory:home}
  TMPDIR=${directory:tmp}
  LANG=C.UTF-8
  HOST=${app-parameters:host}
  PORT=${app-parameters:port}
  URL=${request-frontend:connection-secure_access}
  DOMAIN=${request-frontend:connection-domain}
{%- if database %}
  DATABASE_URL=postgresql://${postgresql:superuser}:${postgresql:password}@${postgresql:ipv4}:${postgresql:port}/${postgresql:dbname}
  PGHOST=${postgresql:ipv4}
  PGPORT=${postgresql:port}
  PGUSER=${postgresql:superuser}
  PGPASSWORD=${postgresql:password}
  PGDATABASE=${postgresql:dbname}
  PGSSLMODE=disable
{%- endif %}
{%- if app['fonts'] %}
  FONTCONFIG_FILE=${fontconfig-conf:output}
{%- endif %}
{%- for secret in secrets %}
{%-   set name, kind = (secret ~ ':').split(':')[:2] %}
  {{ name }}=${secret-{{ name }}{{ '-encoded:value' if kind else ':passwd' }}}
{%- endfor %}
{%- if ipv4 %}
  BIND_ADDRESS=${app-parameters:host}
{%- endif %}
{%- for process in process_list %}
{%-   set is_release = process == 'release' %}


# A script run by a shell, as a Procfile line: from the checkout, after the
# database answers. A service's command is exec'd, so that it gets the signals.
[process-{{ process }}-script]
recipe = slapos.recipe.template
output = ${directory:process}/{{ process }}
inline =
  . ${app-environment:output}
  . ${parameters-environment:output}
{%-   if database %}
  until pg_isready -q -h ${postgresql:ipv4} -p ${postgresql:port}; do sleep 2; done
{%-   endif %}
  cd {{ run_directory }}
{%-   if is_release %}
  rm -f ${directory:run}/release-*
  ( {{ processes[process] }} ) && touch ${release-key:marker}
{%-   else %}
{%-     if release %}
  until [ -e ${release-key:marker} ]; do sleep 1; done
{%-     endif %}
  exec {{ processes[process] }}
{%-   endif %}

# hash-files: a change of command, environment or parameters gives a new
# wrapper, which supervisord starts in place of the old one.
[process-{{ process }}]
<= process-base
command-line = {{ dash }} ${process-{{ process }}-script:output}
wrapper-path = ${directory:{{ 'script' if is_release else 'service' }}}/{{ process }}
hash-files =
  ${app-environment:output}
  ${parameters-environment:output}
  ${process-{{ process }}-script:output}
{%- endfor %}


{%- if ipv4 %}


# jinja2, for the last line's newline, which haproxy requires and inline drops.
[haproxy-cfg]
recipe = slapos.recipe.template:jinja2
output = ${directory:etc}/haproxy.cfg
inline =
  global
    maxconn 256
  defaults
    mode tcp
    timeout connect 5s
    timeout client 1h
    timeout server 1h
  listen app
    bind ipv6@${app-parameters:backend-host}:${app-parameters:backend-port}
    server app ${app-parameters:host}:${app-parameters:port}
{%- raw %}
  {{ "\n" }}
{%- endraw %}

[haproxy]
recipe = slapos.cookbook:wrapper
command-line = {{ haproxy }} -db -f ${haproxy-cfg:output}
wrapper-path = ${directory:service}/haproxy
hash-files = ${haproxy-cfg:output}
{%- endif %}


[request-frontend]
<= slap-connection
recipe = slapos.cookbook:requestoptional
name = {{ name }} Frontend
# XXX We have hardcoded SR URL here.
software-url = http://git.erp5.org/gitweb/slapos.git/blob_plain/HEAD:/software/apache-frontend/software.cfg
shared = true
config-url = ${app-parameters:url}
return = secure_access domain


[listen-promise]
<= monitor-promise-base
promise = check_socket_listening
name = {{ name }}-listen.py
config-host = ${app-parameters:host}
config-port = ${app-parameters:port}

[backend-health-promise]
<= monitor-promise-base
promise = check_url_available
name = {{ name }}-backend-health.py
config-url = ${app-parameters:url}{{ health }}

[frontend-health-promise]
<= monitor-promise-base
promise = check_url_available
name = {{ name }}-frontend-health.py
config-url = ${request-frontend:connection-secure_access}{{ health }}


[publish-connection-parameter]
recipe = slapos.cookbook:publish
<= monitor-publish
url = ${request-frontend:connection-secure_access}
backend-url = ${app-parameters:url}
