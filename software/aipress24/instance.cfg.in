[buildout]
parts =
  postgresql
  aipress24-bootstrap
  aipress24-web
  aipress24-worker
  aipress24-scheduler
  aipress24-listen-promise
  aipress24-frontend-promise
  publish-connection-parameter

eggs-directory = {{ buildout['eggs-directory'] }}
develop-eggs-directory = {{ buildout['develop-eggs-directory'] }}
offline = true

extends = {{ template_monitor }}


[slap-configuration]
recipe = slapos.cookbook:slapconfiguration
computer = ${slap-connection:computer-id}
partition = ${slap-connection:partition-id}
url = ${slap-connection:server-url}
key = ${slap-connection:key-file}
cert = ${slap-connection:cert-file}


[directory]
recipe = slapos.cookbook:mkdirectory
home = ${buildout:directory}
etc = ${:home}/etc
var = ${:home}/var
srv = ${:home}/srv
script = ${:etc}/run
service = ${:etc}/service
log = ${:var}/log
run = ${:var}/run
tmp = ${:srv}/tmp
fontconfig-cache = ${:home}/.fontconfig


[postgresql-password]
recipe = slapos.cookbook:generate.password

[postgresql]
recipe = slapos.cookbook:postgres
bin = {{ postgresql_bin }}/
services = ${directory:service}
dbname = aipress24
superuser = aipress24
password = ${postgresql-password:passwd}
pgdata-directory = ${directory:srv}/postgresql
ipv4 = ${slap-configuration:ipv4-random}
ipv6 =
port = 5432


[secret-key]
recipe = slapos.cookbook:generate.password
bytes = 48

# Must never change: rotating it invalidates the stored password hashes.
[security-password-salt]
recipe = slapos.cookbook:generate.password
bytes = 32


[fontconfig-conf]
recipe = slapos.recipe.template:jinja2
url = {{ template_fonts_conf }}
output = ${directory:etc}/fonts.conf
context =
    key cachedir directory:fontconfig-cache
    key fonts :fonts
    key includes :includes
fonts =
{%- for font in fonts.split() %}
    {{ font }}
{%- endfor %}
includes =
    {{ fontconfig_includes }}


[aipress24-parameters]
host = ${slap-configuration:ipv6-random}
port = 8024
url = http://[${:host}]:${:port}


# The instance's parameters, as environment variables of the app's processes
# under their own names (as `hop3 config set`): ENV_FOR_DYNACONF=production,
# FLASK_S3_ENDPOINT_URL…, which Dynaconf maps over etc/settings.toml. Read after
# the wrapper's environment, so a parameter overrides it.
[aipress24-env]
recipe = slapos.recipe.template:jinja2
output = ${directory:etc}/aipress24.env
context = key parameters slap-configuration:configuration
inline =
{%- raw %}
  {%- for name, value in parameters | dictsort %}
  {%-   if name.isidentifier() %}
  export {{ name }}='{{ value | string | replace("'", "'\\''") }}'
  {%-   else %}
  echo "aipress24.env: an instance parameter is not a variable name" >&2; exit 1
  {%-   endif %}
  {%- endfor %}
{% endraw %}

# Common to the app's processes, which run from the app's checkout (etc/settings.toml).
# Services start with an empty environment: PATH (git for `flask bootstrap`,
# coreutils for the bootstrap's sleep),
# and the libraries that WeasyPrint and python-magic load at run time.
# hash-files: a change of parameters gives new wrappers, which restarts them.
[aipress24-wrapper]
recipe = slapos.cookbook:wrapper
hash-files = ${aipress24-env:output}
environment =
  PATH={{ bin_directory }}:{{ git_bin }}:{{ postgresql_bin }}:{{ coreutils_bin }}
  LD_LIBRARY_PATH={{ library_path }}
  FONTCONFIG_FILE=${fontconfig-conf:output}
  HOME=${directory:home}
  TMPDIR=${directory:tmp}
  LANG=C.UTF-8
  FLASK_SQLALCHEMY_DATABASE_URI=postgresql+psycopg://${postgresql:superuser}:${postgresql:password}@${postgresql:ipv4}:${postgresql:port}/${postgresql:dbname}
  FLASK_SECRET_KEY=${secret-key:passwd}
  FLASK_SECURITY_PASSWORD_SALT=${security-password-salt:passwd}
  FLASK_SERVER_NAME=${request-frontend:connection-domain}
  FLASK_PREFERRED_URL_SCHEME=https


# Empty database: schema from the models, stamped at Alembic's head, then seeded
# (as Hop3's blank deploy). Both steps are idempotent; waits for PostgreSQL.
[aipress24-bootstrap]
<= aipress24-wrapper
command-line =
  {{ dash }} -c ". ${aipress24-env:output} && until {{ postgresql_bin }}/pg_isready -q -h ${postgresql:ipv4} -p ${postgresql:port}; do sleep 2; done && cd {{ app_directory }} && {{ bin_directory }}/aipress24-python scripts/hop3_db_bootstrap.py && {{ bin_directory }}/flask bootstrap && {{ bin_directory }}/flask data bootstrap-users"
wrapper-path = ${directory:script}/aipress24-bootstrap

[aipress24-web]
<= aipress24-wrapper
command-line =
  {{ dash }} -c ". ${aipress24-env:output} && cd {{ app_directory }} && exec {{ bin_directory }}/gunicorn -b [${aipress24-parameters:host}]:${aipress24-parameters:port} -w 2 --timeout 180 --error-logfile ${directory:log}/gunicorn.log \"app.flask.main:create_app()\""
wrapper-path = ${directory:service}/aipress24-web

[aipress24-worker]
<= aipress24-wrapper
command-line =
  {{ dash }} -c ". ${aipress24-env:output} && cd {{ app_directory }} && exec {{ bin_directory }}/dramatiq app.dramatiq.worker_entry --processes 1 --threads 4"
wrapper-path = ${directory:service}/aipress24-worker

[aipress24-scheduler]
<= aipress24-wrapper
command-line =
  {{ dash }} -c ". ${aipress24-env:output} && cd {{ app_directory }} && exec {{ bin_directory }}/flask queue scheduler"
wrapper-path = ${directory:service}/aipress24-scheduler


[request-frontend]
<= slap-connection
recipe = slapos.cookbook:requestoptional
name = aipress24 Frontend
# XXX We have hardcoded SR URL here.
software-url = http://git.erp5.org/gitweb/slapos.git/blob_plain/HEAD:/software/apache-frontend/software.cfg
shared = true
config-url = ${aipress24-parameters:url}
return = secure_access domain


[aipress24-listen-promise]
<= monitor-promise-base
promise = check_socket_listening
name = aipress24-listen.py
config-host = ${aipress24-parameters:host}
config-port = ${aipress24-parameters:port}

# /system/health queries the users table: the app and its database are up.
[aipress24-frontend-promise]
<= monitor-promise-base
promise = check_url_available
name = aipress24-frontend.py
config-url = ${request-frontend:connection-secure_access}/system/health


[publish-connection-parameter]
recipe = slapos.cookbook:publish
<= monitor-publish
url = ${request-frontend:connection-secure_access}
backend-url = ${aipress24-parameters:url}
